# GateHeal Environment Template (placeholders only; never commit secrets)
GATEHEAL_ENV=lab
GATEHEAL_LAB_BACKEND=qemu_kvm
GATEHEAL_LAB_SSH_HOST=127.0.0.1
GATEHEAL_LAB_SSH_PORT=2222

# Optional LLM provider key for the WP7 arms. Export it in your shell for the run;
# do not store a real key in a file. The variable name can be changed with --llm-api-key-env.
DEEPSEEK_API_KEY=your_api_key_placeholder_here
